<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <TargetFrameworks Condition="'$(DemoTargetFrameworks)' != ''">$(DemoTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <ApplicationTitle>UnoEdit</ApplicationTitle>
    <ApplicationId>com.wieslawsoltes.unoedit</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <IsPackable>false</IsPackable>
    <SignAssembly>false</SignAssembly>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <WasmShellMonoRuntimeExecutionMode>Interpreter</WasmShellMonoRuntimeExecutionMode>
    <WasmShellEnableThreading>false</WasmShellEnableThreading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UnoEdit.Uno/UnoEdit.Uno.csproj" />
    <EmbeddedResource Include="../UnoEdit.Demo/Resources/SampleFiles/*">
      <LogicalName>Samples.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
