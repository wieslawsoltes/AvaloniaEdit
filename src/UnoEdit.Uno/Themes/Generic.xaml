<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:search="using:UnoEdit.Search"
    xmlns:completion="using:UnoEdit.CodeCompletion">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="UnoEditSearchBackground" Color="#FFF7F7F7" />
      <SolidColorBrush x:Key="UnoEditSearchForeground" Color="#FF202020" />
      <SolidColorBrush x:Key="UnoEditSearchBorder" Color="#FFB0B0B0" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="UnoEditSearchBackground" Color="#FF292929" />
      <SolidColorBrush x:Key="UnoEditSearchForeground" Color="#FFF0F0F0" />
      <SolidColorBrush x:Key="UnoEditSearchBorder" Color="#FF707070" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="UnoEditSearchBackground" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="UnoEditSearchForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="UnoEditSearchBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style TargetType="search:SearchPanel">
    <Setter Property="Background" Value="{ThemeResource UnoEditSearchBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource UnoEditSearchForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource UnoEditSearchBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="search:SearchPanel">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="8">
            <StackPanel Spacing="6">
              <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PART_searchTextBox" PlaceholderText="Find" AutomationProperties.Name="Search pattern" MinWidth="40" />
                <Button x:Name="PART_findPrevious" Grid.Column="1" Content="↑" MinWidth="30" Padding="6,3" AutomationProperties.Name="Previous match" ToolTipService.ToolTip="Previous match (Shift+F3)" />
                <Button x:Name="PART_findNext" Grid.Column="2" Content="↓" MinWidth="30" Padding="6,3" AutomationProperties.Name="Next match" ToolTipService.ToolTip="Next match (F3)" />
                <Button x:Name="PART_close" Grid.Column="3" Content="×" MinWidth="30" Padding="6,3" AutomationProperties.Name="Close search" ToolTipService.ToolTip="Close (Escape)" />
              </Grid>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox x:Name="PART_matchCase" Content="Aa" MinWidth="42" AutomationProperties.Name="Match case" ToolTipService.ToolTip="Match case" />
                  <CheckBox x:Name="PART_wholeWords" Content="Whole word" AutomationProperties.Name="Whole words" />
                  <CheckBox x:Name="PART_useRegex" Content=".*" MinWidth="42" AutomationProperties.Name="Regular expression" ToolTipService.ToolTip="Regular expression" />
                  <CheckBox x:Name="PART_replaceMode" Content="Replace" />
                </StackPanel>
              </ScrollViewer>
              <StackPanel x:Name="PART_replaceRow" Spacing="6" Visibility="Collapsed">
                <TextBox x:Name="PART_replaceTextBox" PlaceholderText="Replace with" AutomationProperties.Name="Replacement text" />
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                  <Button x:Name="PART_replaceNext" Content="Replace" />
                  <Button x:Name="PART_replaceAll" Content="Replace all" />
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="PART_searchStatus" Text="{TemplateBinding StatusText}" TextWrapping="Wrap" FontSize="12"
                         Foreground="{TemplateBinding Foreground}" AutomationProperties.Name="Search status" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="completion:CompletionList">
    <Setter Property="Background" Value="{ThemeResource UnoEditSearchBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource UnoEditSearchForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource UnoEditSearchBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="completion:CompletionList">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
          <Grid>
            <completion:CompletionListBox x:Name="PART_ListBox" MaxHeight="240" MinWidth="190" IsTabStop="False" FontSize="14" Foreground="{TemplateBinding Foreground}">
              <completion:CompletionListBox.ItemTemplate>
                <DataTemplate x:DataType="completion:ICompletionData">
                  <StackPanel Orientation="Horizontal" Spacing="6" Padding="2">
                    <Image Source="{x:Bind Image}" Width="16" Height="16" />
                    <ContentPresenter Content="{x:Bind Content}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </completion:CompletionListBox.ItemTemplate>
            </completion:CompletionListBox>
            <Control x:Name="PART_Empty" Visibility="Collapsed" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="completion:OverloadViewer">
    <Setter Property="Background" Value="{ThemeResource UnoEditSearchBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource UnoEditSearchForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource UnoEditSearchBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="completion:OverloadViewer">
        <Border Padding="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button x:Name="PART_previous" Content="&#x25B2;" IsTabStop="False" ToolTipService.ToolTip="Previous overload" />
              <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" />
              <Button x:Name="PART_next" Content="&#x25BC;" IsTabStop="False" ToolTipService.ToolTip="Next overload" />
            </StackPanel>
            <ContentPresenter x:Name="PART_header" />
            <ContentPresenter x:Name="PART_content" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
