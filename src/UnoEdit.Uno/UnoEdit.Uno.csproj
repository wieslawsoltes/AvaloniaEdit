<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>UnoEdit.Uno</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <RootNamespace>UnoEdit</RootNamespace>
    <Description>Native Uno Platform control backend for the UnoEdit migration.</Description>
    <PackageTags>uno;editor;code-editor;webassembly</PackageTags>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UnoEdit.Core/UnoEdit.Core.csproj" />
    <ProjectReference Include="../UnoEdit.Rendering.Skia/UnoEdit.Rendering.Skia.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Highlighting/Resources/*.xshd;Highlighting/Resources/*.xsd">
      <LogicalName>UnoEdit.Highlighting.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
