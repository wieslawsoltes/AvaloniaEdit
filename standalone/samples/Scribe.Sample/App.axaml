<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Scribe.Sample.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://Scribe.Avalonia/Themes/Generic.axaml"/>
    <Style Selector="Button"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="11,7"/></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,2"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource ScribeMuted}"/></Style>
  </Application.Styles>
</Application>
