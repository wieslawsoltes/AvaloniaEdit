<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="using:Scribe.Avalonia" xmlns:c="using:Scribe.Core" x:CompileBindings="True">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ScribeBackground">#111C2B</SolidColorBrush>
          <SolidColorBrush x:Key="ScribePanel">#1B293D</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeForeground">#DCE5F2</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeMuted">#8E9FB8</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeBorder">#314158</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeAccent">#A5B6FF</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeSelection">#805880BA</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeCurrentLine">#172840</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ScribeBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ScribePanel">#F2F5FA</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeForeground">#25344B</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeMuted">#687B94</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeBorder">#D8E1EC</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeAccent">#5165BE</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeSelection">#704981D1</SolidColorBrush>
          <SolidColorBrush x:Key="ScribeCurrentLine">#F0F5FB</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ControlTheme x:Key="{x:Type s:ScribeEditor}" TargetType="s:ScribeEditor">
        <Setter Property="Background" Value="{DynamicResource ScribeBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ScribeForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScribeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,monospace"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ScribeSelection}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ScribeAccent}"/>
        <Setter Property="CurrentLineBrush" Value="{DynamicResource ScribeCurrentLine}"/>
        <Setter Property="GutterBrush" Value="{DynamicResource ScribeMuted}"/>
        <Setter Property="Template">
          <ControlTemplate x:DataType="s:ScribeEditor">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <ContentPresenter Content="{TemplateBinding Header}"/>
                <s:SearchBar Grid.Row="1" Name="PART_SearchBar" IsVisible="{TemplateBinding IsSearchOpen}"/>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0" ClipToBounds="True">
                  <ContentPresenter Name="PART_ViewportHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                  <s:EditorOverview Grid.Column="1" Width="60" Margin="5,0" IsVisible="{TemplateBinding ShowOverview}" Owner="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                  <ScrollBar Grid.Column="2" Name="PART_VerticalScrollBar" Orientation="Vertical" Width="14"/>
                </Grid>
                <ScrollBar Grid.Row="3" Name="PART_HorizontalScrollBar" Orientation="Horizontal" Height="14"/>
                <s:EditorStatusBar Grid.Row="4" Text="{TemplateBinding Status}" IsVisible="{TemplateBinding ShowStatusBar}"/>
                <ContentPresenter Grid.Row="5" Content="{TemplateBinding Footer}"/>
                <Popup Name="PART_CompletionPopup" IsLightDismissEnabled="False">
                  <Border Background="{DynamicResource ScribePanel}" BorderBrush="{DynamicResource ScribeAccent}" BorderThickness="1" CornerRadius="5" Padding="4">
                    <ListBox Name="PART_CompletionList" MinWidth="250" MaxWidth="460" MaxHeight="220">
                      <ListBox.ItemTemplate><DataTemplate x:DataType="c:Completion"><StackPanel Margin="5,2" Spacing="3"><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource ScribeMuted}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </Border>
                </Popup>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="ScribeMinimalTheme" TargetType="s:ScribeEditor" BasedOn="{StaticResource {x:Type s:ScribeEditor}}">
        <Setter Property="Template">
          <ControlTemplate x:DataType="s:ScribeEditor">
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ScribeAccent}" BorderThickness="2" CornerRadius="10" Padding="12">
              <Grid RowDefinitions="Auto,*,Auto">
                <s:SearchBar Name="PART_SearchBar" IsVisible="{TemplateBinding IsSearchOpen}"/>
                <ContentPresenter Grid.Row="1" Name="PART_ViewportHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <s:EditorStatusBar Grid.Row="2" Text="{TemplateBinding Status}"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type s:SearchBar}" TargetType="s:SearchBar">
        <Setter Property="Template">
          <ControlTemplate x:DataType="s:SearchBar">
            <Border Background="{DynamicResource ScribePanel}" Padding="10,8" DataContext="{TemplateBinding Controller}">
              <Grid x:DataType="s:SearchController" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox Name="PART_Query" Text="{Binding Pattern,Mode=TwoWay}" PlaceholderText="Find" AutomationProperties.Name="Find text"/>
                <Button Grid.Column="1" Content="↑" Command="{Binding PreviousCommand}" Margin="6,0,0,0" AutomationProperties.Name="Previous match"/>
                <Button Grid.Column="2" Content="↓" Command="{Binding NextCommand}" Margin="4,0,0,0" AutomationProperties.Name="Next match"/>
                <Button Grid.Column="3" Content="✕" Command="{Binding CloseCommand}" Margin="4,0,0,0" AutomationProperties.Name="Close search"/>
                <TextBox Grid.Row="1" Text="{Binding Replacement,Mode=TwoWay}" PlaceholderText="Replace with" Margin="0,5,0,0" AutomationProperties.Name="Replacement text"/>
                <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="Replace" Command="{Binding ReplaceCommand}" Margin="6,5,0,0"/>
                <Button Grid.Row="1" Grid.Column="3" Content="All" Command="{Binding ReplaceAllCommand}" Margin="4,5,0,0"/>
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,4,0,0">
                  <CheckBox Content="Case" IsChecked="{Binding CaseSensitive,Mode=TwoWay}" Margin="0,0,12,0"/>
                  <CheckBox Content="Word" IsChecked="{Binding WholeWord,Mode=TwoWay}" Margin="0,0,12,0"/>
                  <CheckBox Content="Regex" IsChecked="{Binding UseRegex,Mode=TwoWay}" Margin="0,0,12,0"/>
                  <CheckBox Content="Selection" IsChecked="{Binding InSelection,Mode=TwoWay}" Margin="0,0,12,0"/>
                  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ScribeMuted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </WrapPanel>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type s:EditorStatusBar}" TargetType="s:EditorStatusBar">
        <Setter Property="Template"><ControlTemplate x:DataType="s:EditorStatusBar"><Border Background="{DynamicResource ScribePanel}" Padding="12,7"><TextBlock Text="{TemplateBinding Text}" Foreground="{DynamicResource ScribeMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/></Border></ControlTemplate></Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
